#!/bin/sh
# Fast gate only. The full matrix (build, clippy) runs in CI.
set -e

echo "› prettier (staged)"
git diff --cached --name-only --diff-filter=ACM -z | xargs -0 -r pnpm exec prettier --check --ignore-unknown

echo "› oxlint"
pnpm exec oxlint .

echo "› tsc"
pnpm exec tsc --noEmit

echo "› rustfmt"
cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check

echo "› clippy"
cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings
